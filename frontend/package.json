    "@playwright/test": "^1.46.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vitest": "^2.0.5",
    "jsdom": "^25.0.0",
    "tailwindcss": "^3.4.9",
    "autoprefixer": "^10.4.20",
