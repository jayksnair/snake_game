# Backend environment variables
# Copy to .env for local development — NEVER put real secrets in this file

# Turso (production) - get from https://turso.tech
# Use https:// scheme (not libsql://) - works on all platforms including Windows
TURSO_URL=https://your-db-name.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# CORS - set to your Vercel URL in production
ALLOWED_ORIGINS=http://localhost:5173

# Local SQLite (dev only, ignored when TURSO_URL is set)
# DB_PATH=./snake.db
